{
    "name": "jean-beru/fos-http-cache-cloudfront",
    "type": "library",
    "license": "MIT",
    "description": "Tools to manage CloudFront HTTP caching proxy with PHP",
    "keywords": [ "http", "caching", "purge", "invalidation", "cloudfront" ],
    "authors": [
        {
            "name": "Hubert Lenoir",
            "email": "lenoir.hubert@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "JeanBeru\\HttpCacheCloudFront\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeanBeru\\HttpCacheCloudFront\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "async-aws/cloud-front": "^0.1.3 || ^1.0",
        "async-aws/core": "^1.9",
        "friendsofsymfony/http-cache": "^3.0",
        "symfony/options-resolver": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.91.3",
        "phpunit/phpunit": "^10.5.62 || ^11.5.50 || ^12.5.8 || ^13.0",
        "phpstan/phpstan": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
